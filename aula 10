#include <stdio.h>

int main() {
    char nome[50];
    char disciplina[50];
    float n1, n2, n3, media;

    
    printf("Digite o nome do aluno: ");
    scanf(" %[^\n]", nome);

    printf("Digite o nome da disciplina: ");
    scanf(" %[^\n]", disciplina);

    printf("Digite a primeira nota: ");
    scanf("%f", &n1);

    printf("Digite a segunda nota: ");
    scanf("%f", &n2);

    printf("Digite a terceira nota: ");
    scanf("%f", &n3);

    
    media = (n1 + n2 + n3) / 3;

    
    printf("%s, obteve %.1f pontos na media da disciplina %s\n", nome, media, disciplina);

    return 0;
}
