#include <stdio.h>
#include <math.h>

int main() {
    float capital, taxa, montante;
    int tempo;

    printf("Capital: ");
    scanf("%f", &capital);

    printf("Taxa de juros (%%): ");
    scanf("%f", &taxa);

    printf("Tempo: ");
    scanf("%d", &tempo);

    montante = capital * pow((1 + taxa/100), tempo);

    printf("Montante final: %.2f\n", montante);

    return 0;
}
