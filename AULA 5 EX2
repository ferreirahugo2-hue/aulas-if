#include <stdio.h>

int main() {
    float C, i, M;
    int mes;

    printf("Capital: ");
    scanf("%f", &C);

    printf("Juros (%%): ");
    scanf("%f", &i);

    for(mes = 1; mes <= 12; mes++) {
        M = C * (1 + (i/100) * mes);
        printf("Mes %d: %.2f\n", mes, M);
    }

    return 0;
}
