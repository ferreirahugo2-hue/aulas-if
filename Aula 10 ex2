#include <stdio.h>
#include <string.h>

int main() {
    char senha[100];

    printf("Digite a senha: ");
    scanf(" %[^\n]", senha);

    if (strlen(senha) >= 8) {
        printf("Senha valida!\n");
    } else {
        printf("Senha invalida! Deve ter pelo menos 8 caracteres.\n");
    }

    return 0;
}
