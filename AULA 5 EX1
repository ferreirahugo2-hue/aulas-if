#include <stdio.h>
#include <math.h>

int main() {
    float C, i, M;
    int t;

    printf("Capital: ");
    scanf("%f", &C);

    printf("Juros (%%): ");
    scanf("%f", &i);

    printf("Tempo: ");
    scanf("%d", &t);

    M = C * pow((1 + i/100), t);

    printf("Montante: %.2f\n", M);

    return 0;
}
