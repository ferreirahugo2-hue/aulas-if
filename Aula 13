#include <stdio.h>

void comissao(float *p1, float *p2) {
    *p1 = *p1 * 1.10;
    *p2 = *p2 * 1.10;
}

int main() {
    char nome[50];
    float preco1, preco2;

    printf("Digite o nome do produto: ");
    scanf("%s", nome);

    printf("Digite o preco no supermercado 1: ");
    scanf("%f", &preco1);

    printf("Digite o preco no supermercado 2: ");
    scanf("%f", &preco2);

    printf("\nProduto: %s\n", nome);
    printf("Preco 1: %.2f\n", preco1);
    printf("Preco 2: %.2f\n", preco2);

    comissao(&preco1, &preco2);

    printf("\nPrecos com 10%% de aumento:\n");
    printf("Preco 1: %.2f\n", preco1);
    printf("Preco 2: %.2f\n", preco2);

    return 0;
}
